# Public API base URL (must be set at build time for production)
# Example production:
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Canonical site URL for sitemap, Open Graph, and robots (required in production)
# Example production:
# NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# On another device on your LAN, use your machine IP instead of localhost:
# NEXT_PUBLIC_API_URL=http://192.168.1.33:5000/api
# NEXT_PUBLIC_SITE_URL=http://192.168.1.33:3000
