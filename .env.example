# ─── Database ────────────────────────────────────────────────────────────────
# MongoDB connection string (Atlas or local)
# Atlas:  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority
# Local:  mongodb://127.0.0.1:27017/varsovia-kitchen
MONGODB_URI=mongodb://127.0.0.1:27017/varsovia-kitchen

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Example: http://localhost:3000,https://varsovia.com,https://admin.varsovia.com
CLIENT_URL=http://localhost:3000

# ─── Admin Auth ──────────────────────────────────────────────────────────────
# Secret key for the frontend admin panel at /admin (sent as x-admin-key header).
# Generate a strong random key:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Then restart the backend after changing this value.
ADMIN_KEY=8f4c2a9e1b7d3f6c0e5a8b2d4f7c1e9a3b6d0f2e8c5a1b7d3f9e2c4a6

# ─── Rate limits (optional — defaults are production-friendly) ───────────────
# RATE_LIMIT_GLOBAL_MAX=1000
# RATE_LIMIT_CONTACT_MAX=20
# RATE_LIMIT_ADMIN_MAX=200
