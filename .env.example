# ─── Database ────────────────────────────────────────────────────────────────
# MongoDB connection string (Atlas or local)
# Atlas:  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority
# Local:  mongodb://127.0.0.1:27017/varsovia-kitchen
MONGODB_URI=mongodb://127.0.0.1:27017/varsovia-kitchen

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
# Include every domain that calls this API directly from the browser (GET site data, admin, etc.)
# Example: http://localhost:3000,https://www.varsoviadesign.com,https://varsoviadesign.com
CLIENT_URL=http://localhost:3000

# Optional: extra origins (preview URLs, alternate admin panel host)
# CORS_EXTRA_ORIGINS=https://varsovia-design.vercel.app,https://admin.yourdomain.com
# CORS_ALLOW_VERCEL_PREVIEWS=true

# ─── Admin Auth ──────────────────────────────────────────────────────────────
# Required for CMS writes and ?cms=1 admin reads. Sent as header: x-admin-key
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must match Thailand admin VARSOVIA_ADMIN_KEY (server-side only — never expose to browser).
ADMIN_KEY=change-me-generate-a-64-char-hex-secret

# RATE_LIMIT_GLOBAL_MAX=1000
# RATE_LIMIT_CONTACT_MAX=20
# RATE_LIMIT_ADMIN_MAX=200
