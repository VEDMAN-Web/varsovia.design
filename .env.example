# Public API base URL (must be set at build time for production)
# For mobile testing on the same Wi‑Fi, use your PC LAN IP instead of localhost:
# NEXT_PUBLIC_API_URL=http://192.168.1.33:5000/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Canonical site URL for sitemap, Open Graph, and robots
# For mobile testing: NEXT_PUBLIC_SITE_URL=http://192.168.1.33:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
